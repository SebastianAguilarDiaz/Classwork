<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Express test</title>
</head>

<body>
    <% if (locals.error) { %>
        <h3>
            <%= error %>
        </h3>
        <% } %>
            <form action="/greet" method="get">
                Register:
                <input type="text" name="name" id="name" placeholder="Name">
                <input type="submit" value="go next">
            </form>
            <% if (typeof names !== 'undefined' && names.length > 0) { %>
                <ul>
                    <% names.forEach(function(n,i){ %>
                        <li>Hello <a href="/greet/<%= i %>" ><%= n %></a>!</li>
                        <% }) %>
                    </ul>
                    <% } %>
                    <form action="/task" method="post">
                        Register:
                        <input type="text" name="task" id="task" placeholder="Task">
                        <input type="submit" value="Save">
                    </form>
                    <% if (typeof todo !== 'undefined' && todo.length > 0) { %>
                        <ul>
                            <% todo.forEach(function(n,i){ %>
                                <li>
                                    <%= n %>
                                    <a href="/task/delete/<%= i %>">[x]</a>
                                    <a href="/task/up/<%= i %>">↑</a>
                                    <a href="/task/down/<%= i %>">↓</a>

                                </li>
                                <% }) %>
                            </ul>
                            <% } %>
                    
                </body>
                
                </html>